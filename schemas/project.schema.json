{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "type": "object",
  "required": ["project_id", "source_paths", "audience", "duration_minutes", "presentation_type", "language", "fact_boundaries", "imagegen_allowed_uses"],
  "properties": {
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$"},
    "source_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "audience": {"type": "string", "minLength": 2},
    "duration_minutes": {"type": "number", "exclusiveMinimum": 0},
    "presentation_type": {"type": "string"},
    "language": {"enum": ["zh-CN", "en-US", "bilingual"]},
    "fact_boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "imagegen_allowed_uses": {"type": "array", "items": {"enum": ["concept_explanation", "background_visual"]}}
  },
  "additionalProperties": true
}
